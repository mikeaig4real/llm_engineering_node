PORT=3000
NODE_ENV=development
LOG_LEVEL=info
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Embedding Configuration
# Providers: 'transformers' (local ONNX), 'ollama' (Ollama API), 'offline' (deterministic mockup)
EMBEDDING_PROVIDER=transformers

# Match EMBEDDING_MODEL and EMBEDDING_DIMENSIONS based on your choice:
#
# Option A: Local ONNX via @xenova/transformers (Default)
# - Model: Xenova/bge-large-en-v1.5 (Dimensions: 1024)
# - Model: Xenova/bge-small-en-v1.5 (Dimensions: 384)
EMBEDDING_MODEL=Xenova/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024

# Option B: Local Ollama API (EMBEDDING_PROVIDER=ollama)
# - Model: nomic-embed-text (Dimensions: 768)
# - Model: bge-large (Dimensions: 1024)
# - Model: all-minilm (Dimensions: 384)
# Make sure Ollama service is running!
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# Ollama API Base URL (used when EMBEDDING_PROVIDER=ollama or INFERENCE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Inference Configuration
# Providers: 'openrouter', 'ollama'
INFERENCE_PROVIDER=openrouter

# Match INFERENCE_MODEL based on your provider:
#
# Option A: OpenRouter (INFERENCE_PROVIDER=openrouter)
# - Model: google/gemini-2.5-flash
# - Model: meta-llama/llama-3.3-70b-instruct
INFERENCE_MODEL=google/gemini-2.5-flash

# Option B: Local Ollama (INFERENCE_PROVIDER=ollama)
# - Model: llama3.2 (or llama3.2:latest)
# - Model: gemma3:4b
# INFERENCE_MODEL=llama3.2

# Database & Storage Configuration
SQLITE_DB_PATH=.storage/rag.db
ORAMA_INDEX_PATH=.storage/oramaIndex.json
HNSW_INDEX_PATH=.storage/hnsw.index
HNSW_MAX_ELEMENTS=10000
